# runners.conf.example — GitHub Actions multi-runner config for macOS
# Copy to runners.conf, fill in your values, then run:
#   export RUNNER_CFG_PAT=ghp_xxxx
#   ./setup-runners-macos.sh --config runners.conf
#
# Each [section] defines one independent runner and launchd service.
# Values cannot contain '#' (reserved for inline comments).
#
# PAT resolution order per runner:
#   1. 'token' field below (per-runner PAT)
#   2. Env var RUNNER_CFG_PAT_<SECTION_UPPERCASE>  (e.g. RUNNER_CFG_PAT_PROD_ORG)
#   3. Env var RUNNER_CFG_PAT  (global fallback)

# ── GitHub.com org-level runner ───────────────────────────────────────────────
[prod-org]
url     = https://github.com/myorg
# token = ghp_...                        # optional per-runner PAT
name    = macos-arm64-prod               # optional; default: <hostname>-prod-org
labels  = macos,arm64,self-hosted,prod
group   = default                        # optional runner group
dir     = ~/actions-runners/prod-org     # optional; default: ~/actions-runners/<section>
# disableupdate = true                   # stay on current version for 1 month
# ephemeral     = true                   # de-register after each job

# ── GitHub.com repo-level runner ─────────────────────────────────────────────
[dev-repo]
url     = https://github.com/myorg/myrepo
name    = macos-x64-dev
labels  = macos,x64,self-hosted,dev
dir     = ~/actions-runners/dev-repo

# ── GitHub Enterprise Server runner ──────────────────────────────────────────
# The script derives the API base automatically:
#   github.com        → https://api.github.com
#   any other host   → https://<host>/api/v3
[ghes-prod]
url     = https://github.mycompany.com/myorg
# token = ghp_...                        # GHES PAT with admin:org scope
name    = macos-arm64-ghes
labels  = macos,arm64,ghes,self-hosted
dir     = ~/actions-runners/ghes-prod

# ── Second runner on the same server (different repo) ─────────────────────────
[ghes-infra]
url     = https://github.mycompany.com/infra-team/k8s-configs
name    = macos-arm64-ghes-infra
labels  = macos,arm64,ghes,infra
dir     = ~/actions-runners/ghes-infra
